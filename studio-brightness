#!/usr/bin/env python3
"""Get or set the brightness of Apple displays (Cinema, Thunderbolt, Studio, Pro XDR) on Linux.

Two backends, picked automatically per display:
  * the kernel's `appledisplay` backlight device (/sys/class/backlight/appledisplay*),
    which exists for some older Cinema Displays;
  * raw HID feature reports over /dev/hidraw*, for every Apple display whose HID
    descriptor carries the Monitor brightness control (usage page 0x82, usage 0x10).
"""

import argparse
import glob
import os
import shutil
import subprocess
import sys

APPLE_VID = 0x05AC
BRIGHTNESS_USAGE = (0x0082 << 16) | 0x0010

# Display names by USB product ID. Anything else uses the USB product string, so unknown
# Apple displays still work as long as they carry the HID brightness control.
MODELS = {
    0x1114: "Studio Display",
    0x1118: "Studio Display (Gen 2)",
    0x1116: "Studio Display XDR",
    0x9243: "Pro Display XDR",
    0x9227: "Thunderbolt Display",
}


class DisplayError(Exception):
    pass


# ---------------------------------------------------------------- kernel backlight


class BacklightDisplay:
    kind = "backlight"

    def __init__(self, path):
        self.path = path
        self.name = os.path.basename(path)
        # The driver registers its backlight with no parent device, so find the display through
        # the USB interface bound to it. That only identifies it when there's just one.
        ifaces = glob.glob("/sys/bus/usb/drivers/appledisplay/*:*")
        self.pid, self.model = (_usb_info(ifaces[0]) if len(ifaces) == 1
                                else (None, "Apple Cinema Display"))
        self.lo = 0
        self.hi = int(_read(os.path.join(path, "max_brightness")))

    def describe(self):
        return f"{self.name}  {self.model}, kernel appledisplay driver, range {self.lo}-{self.hi}"

    def get_raw(self):
        return int(_read(os.path.join(self.path, "actual_brightness")))

    def set_raw(self, value):
        node = os.path.join(self.path, "brightness")
        if os.access(node, os.W_OK):
            with open(node, "w") as f:
                f.write(str(value))
            return
        # logind lets the active session set backlight brightness without root.
        if shutil.which("busctl"):
            r = subprocess.run(
                ["busctl", "call", "org.freedesktop.login1",
                 "/org/freedesktop/login1/session/auto",
                 "org.freedesktop.login1.Session", "SetBrightness",
                 "ssu", "backlight", self.name, str(value)],
                capture_output=True, text=True)
            if r.returncode == 0:
                return
        raise DisplayError(
            f"no permission to write {node}. Install the udev rule (./install.sh) "
            "and make sure you are in the 'video' group, then log out and back in.")


# ---------------------------------------------------------------- raw HID


def _ioc_rw(nr, length):
    return (3 << 30) | (length << 16) | (ord("H") << 8) | nr


def HIDIOCSFEATURE(length):
    return _ioc_rw(0x06, length)


def HIDIOCGFEATURE(length):
    return _ioc_rw(0x07, length)


def find_feature_field(desc, target):
    """Locate the Feature field for a (page << 16 | usage) in a HID report descriptor.

    Returns (report_id, bit_offset, bit_size, logical_min, logical_max, report_len) where
    bit_offset counts from the start of the hidraw buffer (byte 0 is the report ID) and
    report_len is the hidraw buffer length, or None if the usage is not present.
    """
    g = {"page": 0, "lmin": 0, "lmax": 0, "lmax_u": 0, "size": 0, "count": 0, "rid": 0}
    stack = []
    usages = []
    umin = None
    feature_bits = {}
    found = None
    i = 0
    while i < len(desc):
        prefix = desc[i]
        if prefix == 0xFE:
            i += 3 + (desc[i + 1] if i + 1 < len(desc) else 0)
            continue
        size = (0, 1, 2, 4)[prefix & 3]
        data = bytes(desc[i + 1:i + 1 + size])
        i += 1 + size
        uval = int.from_bytes(data, "little")
        sval = int.from_bytes(data, "little", signed=True) if size else 0
        typ, tag = (prefix >> 2) & 3, prefix >> 4

        if typ == 1:  # global
            if tag == 0:
                g["page"] = uval
            elif tag == 1:
                g["lmin"] = sval
            elif tag == 2:
                g["lmax"], g["lmax_u"] = sval, uval
            elif tag == 7:
                g["size"] = uval
            elif tag == 8:
                g["rid"] = uval
            elif tag == 9:
                g["count"] = uval
            elif tag == 10:
                stack.append(dict(g))
            elif tag == 11 and stack:
                g = stack.pop()
        elif typ == 2:  # local
            full = uval if size == 4 else (g["page"] << 16) | uval
            if tag == 0:
                usages.append(full)
            elif tag == 1:
                umin = full
            elif tag == 2 and umin is not None:
                usages.extend(range(umin, full + 1))
                umin = None
        elif typ == 0:  # main
            if tag == 0xB:  # Feature
                rid = g["rid"]
                start = feature_bits.get(rid, 0)
                is_constant = uval & 1
                if not is_constant and usages and found is None:
                    for n in range(g["count"]):
                        if usages[min(n, len(usages) - 1)] == target:
                            lmax = g["lmax"] if g["lmax"] >= g["lmin"] else g["lmax_u"]
                            found = (rid, start + n * g["size"], g["size"], g["lmin"], lmax)
                            break
                feature_bits[rid] = start + g["size"] * g["count"]
            if tag in (0x8, 0x9, 0xA, 0xB, 0xC):
                usages = []
                umin = None

    if found is None:
        return None
    rid, offset, bits, lo, hi = found
    report_len = 1 + (feature_bits[rid] + 7) // 8
    return rid, offset + 8, bits, lo, hi, report_len


class HidrawDisplay:
    kind = "hidraw"

    def __init__(self, sysdir, pid, field):
        self.name = os.path.basename(sysdir)
        self.devnode = "/dev/" + self.name
        self.pid = pid
        self.model = _usb_info(os.path.join(sysdir, "device"))[1]
        self.rid, self.offset, self.bits, self.lo, self.hi, self.length = field

    def describe(self):
        return (f"{self.name}  {self.model} (05ac:{self.pid:04x}) over hidraw, "
                f"report 0x{self.rid:02x}, range {self.lo}-{self.hi}")

    def _open(self):
        try:
            return os.open(self.devnode, os.O_RDWR)
        except PermissionError:
            raise DisplayError(
                f"no permission to open {self.devnode}. Install the udev rule "
                "(./install.sh), then unplug and replug the display's USB cable. If it "
                f"still fails, product ID {self.pid:04x} may be missing from the rule.")

    def _get_report(self, fd):
        import fcntl
        buf = bytearray(self.length)
        buf[0] = self.rid
        fcntl.ioctl(fd, HIDIOCGFEATURE(len(buf)), buf)
        return buf

    def _field(self, buf):
        return (int.from_bytes(buf, "little") >> self.offset) & ((1 << self.bits) - 1)

    def get_raw(self):
        fd = self._open()
        try:
            return self._field(self._get_report(fd))
        finally:
            os.close(fd)

    def set_raw(self, value):
        import fcntl
        fd = self._open()
        try:
            try:
                buf = self._get_report(fd)
            except OSError:
                buf = bytearray(self.length)
            mask = ((1 << self.bits) - 1) << self.offset
            whole = (int.from_bytes(buf, "little") & ~mask) | (value << self.offset)
            buf = bytearray(whole.to_bytes(self.length, "little"))
            buf[0] = self.rid
            fcntl.ioctl(fd, HIDIOCSFEATURE(len(buf)), buf)
        finally:
            os.close(fd)


# ---------------------------------------------------------------- discovery


def _read(path, mode="r"):
    with open(path, mode) as f:
        return f.read()


def _hid_ids(sysdir):
    """Return (vendor, product) from a hidraw device's uevent HID_ID line."""
    for line in _read(os.path.join(sysdir, "device", "uevent")).splitlines():
        if line.startswith("HID_ID="):
            _bus, vid, pid = line.split("=", 1)[1].split(":")
            return int(vid, 16), int(pid, 16)
    return None, None


def _usb_info(sysdir):
    """Return (product_id, model_name) of the USB device at or above a sysfs device."""
    path = os.path.realpath(sysdir)
    while path != "/":
        try:
            pid = int(_read(os.path.join(path, "idProduct")), 16)
        except (OSError, ValueError):
            path = os.path.dirname(path)
            continue
        try:
            product = _read(os.path.join(path, "product")).strip()
        except OSError:
            product = ""
        return pid, MODELS.get(pid) or product or f"Apple display 05ac:{pid:04x}"
    return None, "Apple display"


def discover():
    displays = []
    for path in sorted(glob.glob("/sys/class/backlight/appledisplay*")):
        try:
            displays.append(BacklightDisplay(path))
        except (OSError, ValueError):
            pass
    for sysdir in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            vid, pid = _hid_ids(sysdir)
            if vid != APPLE_VID:
                continue
            desc = _read(os.path.join(sysdir, "device", "report_descriptor"), "rb")
        except (OSError, ValueError):
            continue
        field = find_feature_field(desc, BRIGHTNESS_USAGE)
        if field:
            displays.append(HidrawDisplay(sysdir, pid, field))
    return displays


# ---------------------------------------------------------------- CLI


def to_pct(d, raw):
    return round((raw - d.lo) * 100 / (d.hi - d.lo))


def from_pct(d, pct):
    pct = max(0, min(100, pct))
    return d.lo + round(pct * (d.hi - d.lo) / 100)


def adjust(d, delta):
    raw = d.get_raw()
    new = from_pct(d, to_pct(d, raw) + delta)
    if new == raw and delta:
        new = max(d.lo, min(d.hi, raw + (1 if delta > 0 else -1)))
    d.set_raw(new)
    return to_pct(d, new)


def notify(pct):
    """Show a self-replacing desktop notification as a lightweight OSD."""
    if not shutil.which("notify-send"):
        return
    id_file = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "studio-brightness.notify-id")
    base = ["notify-send", "-a", "Brightness", "-i", "display-brightness-symbolic",
            "-t", "1500", "-h", f"int:value:{pct}"]
    text = ["Brightness", f"{pct}%"]
    try:
        prev = _read(id_file).strip()
    except OSError:
        prev = ""
    extra = ["-e", "-p"] + (["-r", prev] if prev.isdigit() else [])
    r = subprocess.run(base + extra + text, capture_output=True, text=True)
    if r.returncode == 0:
        try:
            with open(id_file, "w") as f:
                f.write(r.stdout.strip())
        except OSError:
            pass
    else:
        subprocess.run(base + text, capture_output=True)


def osd(pct):
    """Show the on-screen brightness indicator, falling back to a notification."""
    here = os.path.dirname(os.path.realpath(__file__))
    for exe in (os.path.join(here, "studio-brightness-osd"), shutil.which("studio-brightness-osd")):
        if exe and os.access(exe, os.X_OK):
            subprocess.Popen([exe, str(pct)], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return
    notify(pct)


def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="studio-brightness",
        description="Get or set the brightness of Apple displays connected over USB.")
    p.add_argument("-d", "--display", action="append", metavar="NAME",
                   help="only act on this display (e.g. appledisplay0, hidraw3); repeatable")
    p.add_argument("-n", "--notify", action="store_true",
                   help="show a desktop notification with the new brightness")
    p.add_argument("-o", "--osd", action="store_true",
                   help="show an on-screen brightness indicator")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="list detected displays")
    g = sub.add_parser("get", help="print brightness in percent")
    g.add_argument("--raw", action="store_true", help="print the raw hardware value instead")
    s = sub.add_parser("set", help="set brightness in percent (50, 50%%, +10, -10)")
    s.add_argument("value")
    for name, sign in (("up", "Increase"), ("down", "Decrease")):
        c = sub.add_parser(name, help=f"{sign} brightness by STEP percent (default 10)")
        c.add_argument("step", nargs="?", type=float, default=10)
    return p.parse_args(argv)


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    displays = discover()
    if args.display:
        displays = [d for d in displays if d.name in args.display]
    if not displays:
        print("No Apple display found. Is the display's USB cable plugged into the computer?\n"
              "Check with: lsusb | grep -i 05ac", file=sys.stderr)
        return 1

    if args.cmd == "list":
        for d in displays:
            print(d.describe())
        return 0

    multi = len(displays) > 1
    status = 0
    last_pct = None
    for d in displays:
        try:
            if args.cmd == "get":
                raw = d.get_raw()
                value = str(raw) if args.raw else str(to_pct(d, raw))
                print(f"{d.name}: {value}" if multi else value)
                continue
            if args.cmd == "set":
                v = args.value.rstrip("%")
                if v[:1] in "+-":
                    last_pct = adjust(d, float(v))
                else:
                    raw = from_pct(d, float(v))
                    d.set_raw(raw)
                    last_pct = to_pct(d, raw)
            else:
                last_pct = adjust(d, args.step if args.cmd == "up" else -args.step)
        except (DisplayError, OSError, ValueError) as e:
            print(f"{d.name}: {e}", file=sys.stderr)
            status = 1

    if last_pct is not None:
        if args.osd:
            osd(last_pct)
        elif args.notify:
            notify(last_pct)
    return status


if __name__ == "__main__":
    sys.exit(main())
