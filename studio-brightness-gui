#!/usr/bin/env python3
"""Studio Brightness window: one brightness slider per detected Apple display.

Uses the `studio-brightness` script next to this file (or in ~/.local/bin) as its backend.
"""

import importlib.util
import os
import sys
from importlib.machinery import SourceFileLoader

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "io.github.mfat.StudioBrightness"
WEBSITE = "https://github.com/mfat/studio-brightness-linux"
WRITE_DELAY_MS = 40  # coalesce slider drags into one hardware write per interval


def load_backend():
    sys.dont_write_bytecode = True  # don't leave __pycache__ next to the installed scripts
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "studio-brightness"),
                 os.path.expanduser("~/.local/bin/studio-brightness")):
        if os.path.isfile(path):
            loader = SourceFileLoader("studio_brightness", path)
            module = importlib.util.module_from_spec(
                importlib.util.spec_from_loader(loader.name, loader))
            loader.exec_module(module)
            return module
    sys.exit("studio-brightness not found next to this script or in ~/.local/bin")


ab = load_backend()
ERRORS = (ab.DisplayError, OSError, ValueError)


class DisplayRow(Adw.ActionRow):
    def __init__(self, display, on_error):
        super().__init__(title=display.model, subtitle=display.name)
        self.display = display
        self.on_error = on_error
        self.pending = None
        self.syncing = False

        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_digits(0)
        self.scale.set_draw_value(True)
        self.scale.set_value_pos(Gtk.PositionType.RIGHT)
        self.scale.set_format_value_func(lambda _s, v: f"{v:.0f}%")
        self.scale.set_size_request(240, -1)
        self.scale.set_hexpand(True)
        self.scale.set_valign(Gtk.Align.CENTER)
        self.scale.connect("value-changed", self.on_changed)
        self.add_prefix(Gtk.Image.new_from_icon_name("display-brightness-symbolic"))
        self.add_suffix(self.scale)
        self.sync()

    def sync(self):
        """Read the current brightness from the display into the slider."""
        if self.pending is not None:
            return
        try:
            pct = ab.to_pct(self.display, self.display.get_raw())
        except ERRORS as e:
            self.set_sensitive(False)
            self.on_error(f"{self.display.name}: {e}")
            return
        self.set_sensitive(True)
        self.syncing = True
        self.scale.set_value(pct)
        self.syncing = False

    def on_changed(self, scale):
        if self.syncing:
            return
        if self.pending is None:
            GLib.timeout_add(WRITE_DELAY_MS, self.flush)
        self.pending = round(scale.get_value())

    def flush(self):
        pct, self.pending = self.pending, None
        try:
            self.display.set_raw(ab.from_pct(self.display, pct))
        except ERRORS as e:
            self.on_error(f"{self.display.name}: {e}")
        return GLib.SOURCE_REMOVE


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Studio Brightness",
                         default_width=600, default_height=360)
        self.set_size_request(360, 240)
        self.rows = []

        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Rescan displays")
        refresh.connect("clicked", lambda _b: self.populate())
        menu = Gio.Menu()
        menu.append("About Studio Brightness", "app.about")
        header = Adw.HeaderBar()
        header.pack_start(refresh)
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu,
                                       primary=True, tooltip_text="Main Menu"))

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView(content=self.toasts)
        view.add_top_bar(header)
        self.set_content(view)

        # Pick up changes made elsewhere (keyboard shortcuts, CLI) when the window regains focus.
        self.connect("notify::is-active",
                     lambda w, _p: w.is_active() and [r.sync() for r in self.rows])
        self.populate()

    def show_error(self, message):
        self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(message), timeout=6))

    def populate(self):
        self.rows = [DisplayRow(d, self.show_error) for d in ab.discover()]
        if not self.rows:
            self.toasts.set_child(Adw.StatusPage(
                icon_name="video-display-symbolic",
                title="No Apple Display Found",
                description="Make sure the display's USB cable is plugged into the computer, "
                            "then press the refresh button."))
            return
        # PreferencesPage scrolls when there are many displays and keeps rows a readable
        # width when the window is maximized.
        group = Adw.PreferencesGroup()
        for row in self.rows:
            group.add(row)
        page = Adw.PreferencesPage()
        page.add(group)
        self.toasts.set_child(page)


def show_about(app):
    props = dict(
        application_name="Studio Brightness",
        application_icon=APP_ID,
        developer_name="Mehdi",
        version=ab.__version__,
        comments="Brightness control for Apple displays",
        website=WEBSITE,
        issue_url=f"{WEBSITE}/issues",
        license_type=Gtk.License.MIT_X11,
        copyright="© 2026 Mehdi",
    )
    window = app.get_active_window()
    # Adw.AboutDialog needs libadwaita 1.5; AboutWindow covers 1.4.
    has_dialog = hasattr(Adw, "AboutDialog")
    about = Adw.AboutDialog(**props) if has_dialog else Adw.AboutWindow(transient_for=window, **props)
    about.add_acknowledgement_section("Inspired by", [
        "Studio Brightness ++ https://github.com/LitteRabbit-37/Studio-Brightness-PlusPlus",
        "studio-brightness by Sam Johnson https://github.com/sfjohnson/studio-brightness",
    ])
    if has_dialog:
        about.present(None)  # its own window: the app window is too short to host it
    else:
        about.present()


def main():
    Gtk.Window.set_default_icon_name(APP_ID)
    app = Adw.Application(application_id=APP_ID)
    about = Gio.SimpleAction(name="about")
    about.connect("activate", lambda _a, _p: show_about(app))
    app.add_action(about)
    app.connect("activate", lambda a: (a.get_active_window() or Window(a)).present())
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
